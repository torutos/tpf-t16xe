; test_js.tsm
org 0x0400
section .code
start:
    MOV AX, #0x8000
    CMP AX, #0      ; N=1 (отрицательное)
    JS is_neg
    MOV BX, #0      ; не должно выполниться
    HLT
is_neg:
    MOV BX, #1      ; должно выполниться
    JNS not_neg     ; не должно прыгнуть
    HLT
not_neg:
    MOV CX, #0      ; не должно выполниться
    HLT